# Copy to keystore.properties (git-ignored) and fill in. Create the key once, keep it and its passwords safe:
#   (run in android/) keytool -genkeypair -v -keystore capynime-release.jks -alias capynime -keyalg RSA -keysize 2048 -validity 10000
# Lose it and installed apps can no longer be updated.
storeFile=capynime-release.jks
storePassword=
keyAlias=capynime
keyPassword=
