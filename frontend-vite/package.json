{
  "name": "capynime",
  "version": "2.0.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --diagnostic-level=error",
    "test": "vitest run",
    "analyze": "vite build --mode analyze",
    "icons": "node scripts/icons.mjs && pwa-assets-generator",
    "build:apk": "vite build && cap sync android && cd android && gradlew assembleDebug",
    "build:release": "vite build && cap sync android && cd android && gradlew assembleRelease bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@heroui/react": "^2.7.11",
    "@heroui/theme": "^2.4.17",
    "@tanstack/query-async-storage-persister": "^5.104.1",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-persist-client": "^5.104.1",
    "@tanstack/react-virtual": "^3.14.14",
    "@use-gesture/react": "^10.3.1",
    "cheerio": "1.0.0-rc.12",
    "class-variance-authority": "^0.7.1",
    "client-ext-animevsub-helper": "^1.0.45",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.0",
    "hls.js": "1.5.9",
    "htmlparser2": "^8.0.2",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^0.453.0",
    "p-limit": "^6.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.5.4",
    "ts-retry": "^4.2.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@biomejs/biome": "^2.5.15",
    "@capacitor/cli": "^8.5.3",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.20",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^22.1.0",
    "postcss": "^8.4.47",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "0.35.5",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
