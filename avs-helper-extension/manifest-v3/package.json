{
  "name": "avs-helper",
  "displayName": "AVS Helper",
  "version": "1.0.46",
  "description": "Cầu nối request cho web Anime Cinema (fork của AnimeVsub Helper, MIT)",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=development run-p dev:*",
    "dev:prepare": "tsx scripts/prepare.ts",
    "dev:js": "npm run build:js -- --mode development",
    "dev:bg": "tsup --watch ./src",
    "build": "cross-env NODE_ENV=production run-s clear build:prepare build:js build:bg",
    "build:prepare": "tsx scripts/prepare.ts",
    "build:js": "vite build --config vite.config.content.ts",
    "build:bg": "tsup --config ./tsup.config.ts",
    "pack": "cross-env NODE_ENV=production run-p pack:*",
    "pack:zip": "rimraf mv3-extension.zip && jszip-cli add extension/* -o ./mv3-extension.zip",
    "pack:crx": "crx pack extension -o ./mv3-extension.crx",
    "start:chromium": "web-ext run --source-dir ./extension --target=chromium",
    "clear": "rimraf extension"
  },
  "devDependencies": {
    "@modyfi/vite-plugin-yaml": "^1.0.3",
    "@nodelib/fs.scandir": "^2.1.5",
    "bumpp": "^8.2.1",
    "esbuild-plugin-yaml": "^0.0.1",
    "fs-extra": "^10.1.0",
    "tsup": "^6.7.0",
    "tsx": "^3.12.7",
    "vite": "2.9.16",
    "webextension-polyfill": "0.9.0",
    "yaml": "^2.1.3"
  },
  "dependencies": {
    "esbuild-plugin-yaml-import": "^0.1.1"
  }
}
